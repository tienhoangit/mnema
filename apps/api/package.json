{
  "name": "mnema-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute mnema_db --local --file=./migrations/0001_initial.sql",
    "d1:init:prod": "wrangler d1 execute mnema_db --remote --file=./migrations/0001_initial.sql",
    "d1:seed": "wrangler d1 execute mnema_db --local --file=./seed.sql"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.7.4",
    "linkedom": "^0.18.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.158.0"
  }
}
