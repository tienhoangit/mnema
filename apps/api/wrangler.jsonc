{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mnema",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/register", "/authorize", "/token", "/revoke"]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "a046939b0f10492ebca2e853902a0c51"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mnema_db",
      "database_id": "bfcf2510-806d-42c0-b373-7f0ed6bc36b5",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Vectorize index for semantic highlight search.
  // Before deploying, create the index once with dimensions matching your active embedding model:
  //   Workers AI (@cf/baai/bge-small-en-v1.5): npx wrangler vectorize create mnema-highlights --dimensions=384 --metric=cosine
  //   Gemini (gemini-embedding-001 truncated / text-embedding-004) or bge-base: npx wrangler vectorize create mnema-highlights --dimensions=768 --metric=cosine
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "mnema-highlights"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
