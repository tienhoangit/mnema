{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mnema",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/register", "/authorize", "/token", "/revoke"]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "a046939b0f10492ebca2e853902a0c51"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mnema_db",
      "database_id": "bfcf2510-806d-42c0-b373-7f0ed6bc36b5",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
